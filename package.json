{
  "name": "zomlab",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "with-env": "dotenv",
    "prepare": "husky",
    "reset": "bun run clean && bun install",
    "setup": "bun run scripts/setup.ts",

    "dev": "bun run kill:ports && bun run with-env -- turbo run web#dev",
    "dev:api": "bun run kill:ports && bun run with-env -- turbo run api#dev",
    "dev:standalone": "bun run kill:ports && bun run with-env -- turbo run dev",
    "dev:db": "docker compose up -d postgres redis",
    "dev:types": "turbo watch check-types",
    "dev:clean": "turbo clean && rm -rf .turbo",
    "dev:debug": "NODE_OPTIONS='--inspect=9229' bun run dev",
    "kill:ports": "kill $(lsof -tiTCP:3000-3005 -sTCP:LISTEN 2>/dev/null) 2>/dev/null || true",

    "build": "bun run with-env -- turbo run build",

    "check:all": "bun run with-env -- biome check . && syncpack lint && bun run deps:unused && turbo run check-types && vitest run",
    "check-types": "turbo run check-types",
    "check-types:watch": "turbo run check-types:watch",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "format:check": "biome format --check .",

    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "kill $(lsof -tiTCP:${E2E_PORT:-3100} -sTCP:LISTEN 2>/dev/null) 2>/dev/null; playwright test",

    "storybook": "turbo run storybook",
    "build-storybook": "turbo run build-storybook",

    "db:generate": "bun run with-env -- turbo run db:generate",
    "db:push": "bun run with-env -- turbo run db:push",
    "db:migrate": "bun run with-env -- turbo run db:migrate",
    "db:studio": "bun run with-env -- turbo run db:studio",

    "deps:check": "syncpack lint",
    "deps:fix": "syncpack fix",
    "deps:unused": "bun run with-env -- knip",

    "security:audit": "bun audit --production",
    "security:check": "bun audit",

    "version:packages": "changeset version",
    "version:sync": "bun run scripts/sync-version.ts",
    "changeset": "changeset",

    "generate:package": "bun run scripts/generate-package.ts",

    "clean": "rimraf node_modules .turbo dist test-results generated apps/*/{node_modules,.turbo,dist,generated} packages/*/{node_modules,.turbo,dist,generated}"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.6",
    "@changesets/cli": "^2.31.1",
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@playwright/test": "^1.62.0",
    "bun-types": "^1.3.14",
    "dotenv-cli": "^11.0.0",
    "husky": "^9.1.7",
    "jsdom": "^30.0.1",
    "knip": "^6.29.0",
    "lint-staged": "^17.2.0",
    "rimraf": "^6.1.3",
    "syncpack": "^15.3.2",
    "tsdown": "^0.22.14",
    "@types/node": "^26.1.2",
    "turbo": "2.10.7",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  },
  "lint-staged": {
    "*": "biome check --no-errors-on-unmatched --write --files-ignore-unknown=true",
    "*.{ts,tsx}": "biome check --no-errors-on-unmatched --write --files-ignore-unknown=true"
  },
  "engines": {
    "node": ">=24.18.1"
  },
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": "1.3.14"
    }
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "overrides": {
    "postcss": "^8.5.24",
    "sharp": "^0.35.3",
    "uuid": "^14.0.1"
  }
}
