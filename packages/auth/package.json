{
  "name": "@zomlab/auth",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./client": {
      "types": "./src/client.ts",
      "default": "./src/client.ts"
    },
    "./server": {
      "types": "./src/auth.server.ts",
      "default": "./src/auth.server.ts"
    }
  },
  "scripts": {
    "test": "vitest run",
    "check-types": "tsc --noEmit",
    "check-types:watch": "tsc --noEmit --watch"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "^1.6.26",
    "@zomlab/database": "workspace:*",
    "@zomlab/env": "workspace:*",
    "better-auth": "^1.6.25"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@zomlab/tsconfig": "workspace:*",
    "@zomlab/vitest-config": "workspace:*",
    "typescript": "^6.0.3"
  }
}
