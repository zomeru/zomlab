{
  "extends": "@zomlab/tsconfig/base.json",
  "compilerOptions": {
    "lib": ["ESNext"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "outDir": "dist",
    "rootDir": "src",
    "paths": {
      ".prisma/client": ["../database/node_modules/.prisma/client"],
      ".prisma/client/*": ["../database/node_modules/.prisma/client/*"]
    }
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
