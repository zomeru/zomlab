# ── App ──────────────────────────────────────────
NODE_ENV="development"
E2E_PORT="3100"

# ── Database ─────────────────────────────────────
DATABASE_URL="postgresql://user:password@localhost:5432/zomlabdb"

# ── Auth ─────────────────────────────────────────
BETTER_AUTH_SECRET="change-me-to-a-random-string-at-least-32-chars" # openssl rand -base64 32
BETTER_AUTH_URL="http://localhost:3000"
# Comma-separated hostnames. Add the production hostname and any intentional
# Workers preview wildcard, for example: zomlab.example.com,*.zomlab.workers.dev
BETTER_AUTH_ALLOWED_HOSTS="localhost:3000,localhost:3100"

# ── OAuth ────────────────────────────────────────
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
