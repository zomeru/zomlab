# ── App ──────────────────────────────────────────
APP_ENV="staging"
E2E_PORT="3100"

# ── Database ─────────────────────────────────────
DATABASE_URL="postgresql://user:password@localhost:5432/zomlabdb"

# ── Auth ─────────────────────────────────────────
BETTER_AUTH_SECRET="change-me-to-a-random-string-at-least-32-chars" # openssl rand -base64 32
BETTER_AUTH_URL="http://localhost:3000"
# Comma-separated hostnames. Add the production hostname and any intentional
# Workers preview wildcard, for example: zomlab.example.com,*.zomlab.workers.dev
BETTER_AUTH_ALLOWED_HOSTS="localhost:3000,localhost:3100"

# ── OAuth ────────────────────────────────────────
BETTER_AUTH_GITHUB_CLIENT_ID=""
BETTER_AUTH_GITHUB_CLIENT_SECRET=""
BETTER_AUTH_GOOGLE_CLIENT_ID=""
BETTER_AUTH_GOOGLE_CLIENT_SECRET=""

# ── Payments (sandbox/test mode only) ────────────
STRIPE_SECRET_KEY=""
STRIPE_PUBLISHABLE_KEY=""
STRIPE_WEBHOOK_SECRET=""
PAYMONGO_PUBLIC_KEY=""
PAYMONGO_SECRET_KEY=""
PAYMONGO_WEBHOOK_SECRET=""
PAYPAL_CLIENT_ID=""
PAYPAL_CLIENT_SECRET=""
PAYPAL_WEBHOOK_ID=""
PAYPAL_ENVIRONMENT="sandbox"
