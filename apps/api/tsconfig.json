{
  "extends": "@zomlab/tsconfig/base.json",
  "compilerOptions": {
    "lib": ["ESNext"],
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "noEmit": true,
    "types": ["./worker-configuration.d.ts"]
  },
  "include": ["src/**/*.ts", "vite.config.ts", "worker-configuration.d.ts"],
  "exclude": ["node_modules", "dist"]
}
