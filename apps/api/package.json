{
  "name": "api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run --hot src/index.ts",
    "build": "bun build src/index.ts --outdir dist --target bun",
    "start": "bun run dist/index.js",
    "check-types": "tsc --noEmit",
    "check-types:watch": "tsc --noEmit --watch"
  },
  "dependencies": {
    "@elysiajs/cors": "1.4.2",
    "@elysiajs/openapi": "1.4.15",
    "@elysiajs/swagger": "1.3.1",
    "@zomlab/auth": "workspace:*",
    "@zomlab/database": "workspace:*",
    "@zomlab/env": "workspace:*",
    "elysia": "^1.4.29",
    "elysia-rate-limit": "^4.6.2",
    "elysiajs-helmet": "1.0.5"
  },
  "devDependencies": {
    "@zomlab/vitest-config": "workspace:*",
    "@zomlab/tsconfig": "workspace:*",
    "bun-types": "^1.3.14",
    "typescript": "^6.0.3"
  }
}
