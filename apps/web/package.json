{
  "name": "@zomlab/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "CLOUDFLARE_ENV=staging vite dev",
    "build": "CLOUDFLARE_ENV=staging vite build --mode staging && tsc --noEmit",
    "build:production": "CLOUDFLARE_ENV=production vite build --mode production && tsc --noEmit",
    "preview": "CLOUDFLARE_ENV=staging vite preview",
    "deploy": "pnpm run build && wrangler deploy --env staging",
    "deploy:production": "pnpm run build:production && wrangler deploy --env production",
    "versions:upload": "pnpm run build && wrangler versions upload --env staging",
    "versions:upload:production": "pnpm run build:production && wrangler versions upload --env production",
    "cf:typegen": "wrangler types --env staging",
    "cf:typegen:check": "wrangler types --check --env staging",
    "cf:deploy:check": "pnpm run build && wrangler deploy --env staging --dry-run",
    "cf:deploy:check:production": "pnpm run build:production && wrangler deploy --env production --dry-run",
    "cf:startup": "wrangler check startup --outfile dist/worker-startup.cpuprofile",
    "check-types": "tsc --noEmit",
    "check-types:watch": "tsc --noEmit --watch",
    "test": "vitest run",
    "test:workers": "vitest run --config vitest.workers.config.ts"
  },
  "dependencies": {
    "@hono/zod-openapi": "1.5.2",
    "@mdx-js/mdx": "^3.1.1",
    "@mdx-js/react": "^3.1.1",
    "@mdx-js/rollup": "^3.1.1",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-router": "^1.170.23",
    "@tanstack/react-start": "^1.168.40",
    "@tanstack/react-table": "9.1.2",
    "@zomlab/auth": "workspace:*",
    "@zomlab/contracts": "workspace:*",
    "@zomlab/database": "workspace:*",
    "@zomlab/ui": "workspace:*",
    "hono": "^4.13.1",
    "hono-rate-limiter": "^0.5.3",
    "lucide-react": "^1.31.0",
    "mermaid": "^11.16.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "remark-gfm": "^4.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.51.1",
    "@cloudflare/vitest-pool-workers": "^0.21.2",
    "@shikijs/rehype": "4.4.3",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-devtools": "^0.10.9",
    "@tanstack/react-query-devtools": "^5.101.4",
    "@tanstack/react-router-devtools": "^1.167.1",
    "@tanstack/react-router-ssr-query": "^1.167.1",
    "@types/mdx": "^2.0.14",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.5",
    "@zomlab/tsconfig": "workspace:*",
    "@zomlab/vitest-config": "workspace:*",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vite": "^8.2.0",
    "vitest": "^4.1.10",
    "wrangler": "^4.120.0"
  }
}
