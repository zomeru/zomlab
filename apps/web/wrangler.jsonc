{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "zomlab",
  "main": "@tanstack/react-start/server-entry",
  "compatibility_date": "2026-08-04",
  "compatibility_flags": ["nodejs_compat"],
  "preview_urls": true,
  "cache": {
    "enabled": true
  },
  "observability": {
    "enabled": true
  },
  "env": {
    "production": {
      "preview_urls": false
    }
  },
  "ratelimits": [
    {
      "name": "MY_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 100,
        "period": 60
      }
    }
  ]
}
