{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": "src/server.ts",
  "compatibility_date": "2026-08-08",
  "compatibility_flags": ["nodejs_compat"],
  "placement": {
    "region": "aws:ap-southeast-1"
  },
  "preview_urls": true,
  "durable_objects": {
    "bindings": [
      {
        "name": "REALTIME_HUB",
        "class_name": "RealtimeHub"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["RealtimeHub"]
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "persist": true,
      "head_sampling_rate": 1
    }
  },
  "env": {
    "staging": {
      "name": "zomlab-staging",
      "vars": {
        "APP_ENV": "staging",
        "BETTER_AUTH_URL": "https://zomlab-staging.zomer.workers.dev",
        "BETTER_AUTH_ALLOWED_HOSTS": "zomlab-staging.zomer.workers.dev",
        "BETTER_AUTH_GITHUB_CLIENT_ID": "Ov23lieSOSh0vW0h5GkW",
        "BETTER_AUTH_GOOGLE_CLIENT_ID": "613252713855-3gi0bub6162bqgmk0rs3b3ojia3e3a98.apps.googleusercontent.com",
        "PAYPAL_CLIENT_ID": "BAAt8StKXto6FEDwn3_ZTzBtyUuX_MuuL6H-ZyGyfQR9N6389jazHZvEAehfl8AIxjnylxn_JCJLvYaj7I",
        "PAYPAL_WEBHOOK_ID": "2R314379AX163601V"
      },
      "ratelimits": [
        {
          "name": "MY_RATE_LIMITER",
          "namespace_id": "1001",
          "simple": {
            "limit": 100,
            "period": 60
          }
        }
      ],
      "durable_objects": {
        "bindings": [
          {
            "name": "REALTIME_HUB",
            "class_name": "RealtimeHub"
          }
        ]
      },
      "r2_buckets": [
        {
          "binding": "FILE_UPLOADS",
          "bucket_name": "zomlab-uploads-staging"
        }
      ]
    },
    "production": {
      "name": "zomlab",
      "vars": {
        "APP_ENV": "production",
        "BETTER_AUTH_URL": "https://lab.zomeru.dev",
        "BETTER_AUTH_ALLOWED_HOSTS": "lab.zomeru.dev",
        "BETTER_AUTH_GITHUB_CLIENT_ID": "Ov23li2eRKovhCAzWZ2r",
        "BETTER_AUTH_GOOGLE_CLIENT_ID": "613252713855-3gi0bub6162bqgmk0rs3b3ojia3e3a98.apps.googleusercontent.com",
        "PAYPAL_CLIENT_ID": "BAAt8StKXto6FEDwn3_ZTzBtyUuX_MuuL6H-ZyGyfQR9N6389jazHZvEAehfl8AIxjnylxn_JCJLvYaj7I",
        "PAYPAL_WEBHOOK_ID": "2R314379AX163601V"
      },
      "routes": [
        {
          "pattern": "lab.zomeru.dev",
          "custom_domain": true
        }
      ],
      "preview_urls": true,
      "ratelimits": [
        {
          "name": "MY_RATE_LIMITER",
          "namespace_id": "1001",
          "simple": {
            "limit": 100,
            "period": 60
          }
        }
      ],
      "durable_objects": {
        "bindings": [
          {
            "name": "REALTIME_HUB",
            "class_name": "RealtimeHub"
          }
        ]
      },
      "r2_buckets": [
        {
          "binding": "FILE_UPLOADS",
          "bucket_name": "zomlab-uploads"
        }
      ]
    }
  }
}
