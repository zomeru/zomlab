{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": "@tanstack/react-start/server-entry",
  "compatibility_date": "2026-08-08",
  "compatibility_flags": ["nodejs_compat"],
  "preview_urls": true,
  "observability": {
    "enabled": true
  },
  "env": {
    "staging": {
      "name": "zomlab-staging",
      "vars": {
        "APP_ENV": "staging"
      },
      "ratelimits": [
        {
          "name": "MY_RATE_LIMITER",
          "namespace_id": "1001",
          "simple": {
            "limit": 100,
            "period": 60
          }
        }
      ]
    },
    "production": {
      "name": "zomlab-production",
      "vars": {
        "APP_ENV": "production"
      },
      "preview_urls": true,
      "ratelimits": [
        {
          "name": "MY_RATE_LIMITER",
          "namespace_id": "1001",
          "simple": {
            "limit": 100,
            "period": 60
          }
        }
      ]
    }
  }
}
