{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "zomlab",
  "main": "@tanstack/react-start/server-entry",
  "compatibility_date": "2026-08-08",
  "compatibility_flags": ["nodejs_compat"],
  "preview_urls": true,
  "observability": {
    "enabled": true
  },
  "env": {
    "production": {
      "preview_urls": true,
      "ratelimits": [
        {
          "name": "MY_RATE_LIMITER",
          "namespace_id": "1001",
          "simple": {
            "limit": 100,
            "period": 60
          }
        }
      ]
    }
  },
  "ratelimits": [
    {
      "name": "MY_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 100,
        "period": 60
      }
    }
  ]
}
