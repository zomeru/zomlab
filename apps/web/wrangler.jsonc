{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": "@tanstack/react-start/server-entry",
  "compatibility_date": "2026-08-08",
  "compatibility_flags": ["nodejs_compat"],
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "persist": true,
      "head_sampling_rate": 1
    }
  },
  "env": {
    "staging": {
      "name": "zomlab-staging",
      "vars": {
        "APP_ENV": "staging",
        "BETTER_AUTH_URL": "https://zomlab-staging.zomer.workers.dev",
        "BETTER_AUTH_ALLOWED_HOSTS": "zomlab-staging.zomer.workers.dev"
      },
      "ratelimits": [
        {
          "name": "MY_RATE_LIMITER",
          "namespace_id": "1001",
          "simple": {
            "limit": 100,
            "period": 60
          }
        }
      ]
    },
    "production": {
      "name": "zomlab",
      "vars": {
        "APP_ENV": "production",
        "BETTER_AUTH_URL": "https://zomlab.zomer.workers.dev",
        "BETTER_AUTH_ALLOWED_HOSTS": "zomlab.zomer.workers.dev"
      },
      "preview_urls": true,
      "ratelimits": [
        {
          "name": "MY_RATE_LIMITER",
          "namespace_id": "1001",
          "simple": {
            "limit": 100,
            "period": 60
          }
        }
      ]
    }
  }
}
