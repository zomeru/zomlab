{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "zomlab-web",
  "main": "@tanstack/react-start/server-entry",
  "compatibility_date": "2026-08-04",
  "compatibility_flags": ["nodejs_compat"],
  "preview_urls": true,
  "observability": {
    "enabled": true
  },
  "env": {
    "production": {
      "preview_urls": false
    }
  }
}
