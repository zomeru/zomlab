{
  "$schema": "./node_modules/turbo/schema.json",
  "ui": "tui",
  "envMode": "loose",
  "globalDependencies": ["pnpm-lock.yaml", "pnpm-workspace.yaml", ".env"],
  "globalPassThroughEnv": ["E2E_PORT"],
  "remoteCache": {
    "signature": true
  },
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".output/**", "dist/**"]
    },
    "build:production": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".output/**", "dist/**"]
    },
    "deploy": {
      "dependsOn": ["build"],
      "cache": false
    },
    "versions:upload": {
      "dependsOn": ["build"],
      "cache": false
    },
    "test": {
      "dependsOn": ["^test"],
      "outputs": []
    },
    "check-types": {
      "dependsOn": ["^check-types"]
    },
    "check-types:watch": {
      "cache": false,
      "persistent": true
    },
    "cf:typegen": {
      "outputs": ["worker-configuration.staging.d.ts", "worker-configuration.production.d.ts"]
    },
    "cf:typegen:check": {
      "outputs": []
    },
    "cf:deploy:check": {
      "dependsOn": ["build"],
      "cache": false
    },
    "cf:deploy:check:production": {
      "dependsOn": ["build:production"],
      "cache": false
    },
    "cf:startup": {
      "dependsOn": ["build"],
      "cache": false
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "storybook": {
      "cache": false,
      "persistent": true
    },
    "build-storybook": {
      "dependsOn": ["^build"],
      "outputs": ["storybook-static/**"]
    },

    "db:generate": {
      "outputs": ["drizzle/**"]
    },
    "db:push": {
      "cache": false
    },
    "db:migrate": {
      "cache": false
    },
    "db:studio": {
      "cache": false,
      "persistent": true
    }
  }
}
