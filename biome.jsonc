{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "assist": { "actions": { "source": { "organizeImports": "on" } } },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended"
    }
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always",
      "trailingCommas": "all"
    }
  },
  "files": {
    "includes": [
      "**",
      "!**/.agents",
      "!**/.claude",
      "!**/.opencode",
      "!**/.codex",
      "!**/.turbo",
      "!**/.next",
      "!**/dist",
      "!**/node_modules",
      "!**/coverage",
      "!**/public",
      "!**/out",
      "!**/graphify-out",
      "!**/drizzle",
      "!**/routeTree.gen.ts",
      "!**/worker-configuration.d.ts"
    ]
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  }
}
